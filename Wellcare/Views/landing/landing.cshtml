@{
    Layout = null;
    ViewData["Title"] = "Wellnest - Compassionate Care";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wellnest - Compassionate Care</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/@@phosphor-icons/web"></script>
    <style>
        :root {
            --primary: #2563EB;
            --primary-dark: #1E40AF;
            --secondary: #10B981;
            --bg-color: #F8FAFC;
            --card-bg: rgba(255, 255, 255, 0.6);
            --text-main: #0F172A;
            --text-muted: #64748B;
            --border: #E2E8F0;
            --radius-lg: 24px;
            --radius-pill: 50px;
            --shadow-soft: 0 10px 40px -10px rgba(0, 0, 0, 0.05);
            --shadow-hover: 0 20px 40px -10px rgba(37, 99, 235, 0.1);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            overflow-x: hidden;
            position: relative;
            min-height: 100vh;
            line-height: 1.6;
        }

        #bg-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            opacity: 0.6;
        }

        .container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        header {
            padding: 2rem 0;
            position: absolute;
            width: 100%;
            top: 0;
            z-index: 10;
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-weight: 800;
            font-size: 1.75rem;
            color: var(--primary);
            letter-spacing: -0.03em;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .logo i {
                font-size: 1.5rem;
            }

        h1, h2, h3 {
            line-height: 1.1;
            letter-spacing: -0.02em;
        }

        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding-top: 6rem;
            position: relative;
        }

        .hero-content {
            max-width: 900px;
            animation: fadeIn 0.8s ease-out;
        }

        .tagline {
            display: inline-block;
            background: rgba(37, 99, 235, 0.1);
            color: var(--primary);
            padding: 0.5rem 1rem;
            border-radius: var(--radius-pill);
            font-size: 0.875rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
        }

        .hero-title {
            font-size: 4.5rem;
            font-weight: 800;
            margin-bottom: 1.5rem;
            color: var(--text-main);
        }

            .hero-title span {
                color: var(--primary);
                position: relative;
                display: inline-block;
            }

        .hero-subtitle {
            font-size: 1.25rem;
            color: var(--text-muted);
            margin-bottom: 3rem;
            max-width: 540px;
            font-weight: 500;
        }

        .hero-actions {
            display: flex;
            gap: 1rem;
        }

        .features {
            padding: 8rem 0;
        }

        .features-header {
            text-align: center;
            max-width: 600px;
            margin: 0 auto 5rem;
        }

        .section-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 1rem;
        }

        .section-subtitle {
            color: var(--text-muted);
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2.5rem;
        }

        .card {
            background: var(--card-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.8);
            padding: 2.5rem;
            border-radius: var(--radius-lg);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

            .card:hover {
                transform: translateY(-8px);
                box-shadow: var(--shadow-hover);
                background: rgba(255, 255, 255, 0.85);
                border-color: white;
            }

        .feature-icon-wrapper {
            width: 64px;
            height: 64px;
            background: linear-gradient(135deg, rgba(37, 99, 235, 0.1) 0%, rgba(37, 99, 235, 0.05) 100%);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.5rem;
            color: var(--primary);
            font-size: 2rem;
            transition: transform 0.3s ease;
        }

        .card:hover .feature-icon-wrapper {
            transform: scale(1.1) rotate(5deg);
            background: var(--primary);
            color: white;
        }

        .card h3 {
            font-size: 1.5rem;
            margin-bottom: 1rem;
            font-weight: 700;
        }

        .card p {
            color: var(--text-muted);
            font-size: 1rem;
        }

        .btn {
            padding: 1rem 2rem;
            border-radius: var(--radius-pill);
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1rem;
            cursor: pointer;
            border: none;
        }

        .btn-primary {
            background: var(--primary);
            color: white;
            box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.2);
        }

            .btn-primary:hover {
                background: var(--primary-dark);
                transform: translateY(-2px);
                box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.3);
            }

        .btn-outline {
            background: white;
            color: var(--text-main);
            border: 1px solid var(--border);
        }

            .btn-outline:hover {
                border-color: var(--primary);
                color: var(--primary);
                transform: translateY(-2px);
                box-shadow: var(--shadow-soft);
            }

        footer {
            padding: 4rem 0 2rem;
            margin-top: 4rem;
            border-top: 1px solid rgba(226, 232, 240, 0.6);
            text-align: center;
            color: var(--text-muted);
            font-size: 0.875rem;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 768px) {
            .hero-title {
                font-size: 3rem;
            }

            .hero {
                padding-top: 8rem;
                padding-bottom: 4rem;
                min-height: auto;
            }

            .features {
                padding: 4rem 0;
            }

            .btn {
                padding: 0.875rem 1.5rem;
            }
        }
    </style>
</head>
<body>
    <canvas id="bg-canvas"></canvas>

    <header>
        <div class="container header-content">
            <a href="#" style="text-decoration: none;">
                <h1 class="logo"><i class="ph-fill ph-first-aid-kit"></i> Wellnest</h1>
            </a>
            <a asp-controller="caretakerLogin" asp-action="Login" class="btn btn-primary">
                Caretaker Login <i class="ph-bold ph-arrow-right"></i>
            </a>
        </div>
    </header>

    <main>
        <section class="hero">
            <div class="container hero-content">
                <h2 class="hero-title">Empowering Care,<br><span>Enhancing Lives.</span></h2>
                <p class="hero-subtitle">Advanced technology for elder safety and peace of mind. We connect families with professional caretakers and smart monitoring tools.</p>
                <div class="hero-actions">
                    <a asp-controller="caretakerRegister" asp-action="Register" class="btn btn-primary">Get Started</a>
                </div>
            </div>
        </section>

        <section class="features">
            <div class="container">
                <div class="features-header">
                    <h2 class="section-title">Complete Protection</h2>
                    <p class="section-subtitle">Everything you need to ensure the safety and well-being of your loved ones.</p>
                </div>

                <div class="features-grid">
                    <div class="card">
                        <div class="feature-icon-wrapper">
                            <i class="ph-fill ph-map-pin"></i>
                        </div>
                        <h3>Live Tracking</h3>
                        <p>Real-time location monitoring ensures you always know where your loved ones are.</p>
                    </div>
                    <div class="card">
                        <div class="feature-icon-wrapper">
                            <i class="ph-fill ph-warning-circle"></i>
                        </div>
                        <h3>Fall Detection</h3>
                        <p>Instant alerts sent to caretakers and family members when a fall is detected.</p>
                    </div>
                    <div class="card">
                        <div class="feature-icon-wrapper">
                            <i class="ph-fill ph-pill"></i>
                        </div>
                        <h3>Prescription</h3>
                        <p>Automated reminders and tracking for medication schedules and refills.</p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer>
        <div class="container footer-content">
            <p>&copy; 2026 Wellnest. All rights reserved.</p>
        </div>
    </footer>

    <script>
        const canvas = document.getElementById('bg-canvas');
        const ctx = canvas.getContext('2d');

        let width, height;
        let particles = [];
        const particleCount = 50;
        const connectionDistance = 180;
        const mouseRange = 250;

        let mouse = { x: null, y: null };

        function resize() {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        }

        window.addEventListener('resize', resize);
        window.addEventListener('mousemove', e => {
            mouse.x = e.x;
            mouse.y = e.y;
        });
        window.addEventListener('mouseleave', () => {
            mouse.x = null;
            mouse.y = null;
        });

        class Particle {
            constructor() {
                this.x = Math.random() * width;
                this.y = Math.random() * height;
                this.vx = (Math.random() - 0.5) * 0.3;
                this.vy = (Math.random() - 0.5) * 0.3;
                this.size = Math.random() * 2 + 1;
                this.color = `rgba(37, 99, 235, ${Math.random() * 0.15 + 0.05})`;
            }

            update() {
                this.x += this.vx;
                this.y += this.vy;

                if (this.x < 0 || this.x > width) this.vx *= -1;
                if (this.y < 0 || this.y > height) this.vy *= -1;

                if (mouse.x != null) {
                    let dx = mouse.x - this.x;
                    let dy = mouse.y - this.y;
                    let distance = Math.sqrt(dx * dx + dy * dy);

                    if (distance < mouseRange) {
                        const forceDirectionX = dx / distance;
                        const forceDirectionY = dy / distance;
                        const force = (mouseRange - distance) / mouseRange;
                        const directionX = forceDirectionX * force * 0.5;
                        const directionY = forceDirectionY * force * 0.5;

                        this.vx += directionX;
                        this.vy += directionY;

                        this.vx *= 0.96;
                        this.vy *= 0.96;
                    }
                }
            }

            draw() {
                ctx.fillStyle = this.color;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        function init() {
            resize();
            particles = [];
            for (let i = 0; i < particleCount; i++) {
                particles.push(new Particle());
            }
        }

        function animate() {
            ctx.clearRect(0, 0, width, height);

            particles.forEach(p => {
                p.update();
                p.draw();
            });

            for (let i = 0; i < particles.length; i++) {
                for (let j = i; j < particles.length; j++) {
                    let dx = particles[i].x - particles[j].x;
                    let dy = particles[i].y - particles[j].y;
                    let distance = Math.sqrt(dx * dx + dy * dy);

                    if (distance < connectionDistance) {
                        ctx.beginPath();
                        let opacity = 1 - (distance / connectionDistance);
                        ctx.strokeStyle = `rgba(37, 99, 235, ${opacity * 0.8})`;
                        ctx.lineWidth = 1;
                        ctx.moveTo(particles[i].x, particles[i].y);
                        ctx.lineTo(particles[j].x, particles[j].y);
                        ctx.stroke();
                    }
                }
            }

            requestAnimationFrame(animate);
        }

        init();
        animate();
    </script>
</body>
</html>
