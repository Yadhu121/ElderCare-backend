@model wellcare.Models.ElderProfileViewModel

@{
    Layout = null;
    ViewData["Title"] = "Elder Profile";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/@@phosphor-icons/web"></script>

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <style>
        :root {
            --primary: #2563EB;
            --primary-dark: #1E40AF;
            --secondary: #10B981;
            --danger: #EF4444;
            --warning: #F59E0B;
            --bg-color: #F8FAFC;
            --card-bg: #FFFFFF;
            --text-main: #0F172A;
            --text-muted: #64748B;
            --border: #E2E8F0;
            --radius-lg: 24px;
            --radius-pill: 50px;
            --shadow-soft: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.025);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            line-height: 1.6;
        }

        header {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border);
            padding: 1rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 1.5rem;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
        }

        .back-link {
            text-decoration: none;
            color: var(--text-muted);
            font-weight: 600;
            font-size: 0.875rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: color 0.2s;
        }

            .back-link:hover {
                color: var(--primary);
            }

        main {
            flex: 1;
            padding: 2rem;
            width: 100%;
            max-width: 1000px;
            margin: 0 auto;
        }

        .profile-container {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .card {
            background: var(--card-bg);
            border-radius: var(--radius-lg);
            padding: 2rem;
            box-shadow: var(--shadow-lg);
            border: 1px solid var(--border);
        }

        .profile-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 2rem;
        }

        .profile-title h2 {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            color: var(--text-main);
            margin-bottom: 0.25rem;
        }

        .profile-subtitle {
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .info-item label {
            display: block;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            margin-bottom: 0.25rem;
            font-weight: 600;
        }

        .info-item span {
            font-size: 1.125rem;
            font-weight: 600;
            color: var(--text-main);
        }

        .controls {
            display: flex;
            gap: 1rem;
            align-items: center;
            flex-wrap: wrap;
            margin-bottom: 1.5rem;
        }

        .btn-primary {
            padding: 0.75rem 1.5rem;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: var(--radius-pill);
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.2);
        }

            .btn-primary:hover {
                background: var(--primary-dark);
                transform: translateY(-2px);
                box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.3);
            }

        #statusBox {
            padding: 0.75rem 1.25rem;
            border-radius: var(--radius-pill);
            font-size: 0.875rem;
            font-weight: 500;
            background: #F3F4F6;
            color: var(--text-muted);
            border: 1px solid var(--border);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
        }

        #map {
            height: 400px;
            width: 100%;
            border-radius: 16px;
            z-index: 1;
            margin-top: 1rem;
        }

        .video-container {
            display: none;
            width: 100%;
            margin-top: 1rem;
            border-radius: 16px;
            overflow: hidden;
            background: #000;
            aspect-ratio: 16 / 9;
            position: relative;
            border: 1px solid var(--border);
        }

        .video-container img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .video-overlay {
            position: absolute;
            top: 1rem;
            left: 1rem;
            background: rgba(0, 0, 0, 0.5);
            color: white;
            padding: 0.5rem 1rem;
            border-radius: var(--radius-pill);
            font-size: 0.75rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            backdrop-filter: blur(4px);
        }

        .video-overlay .live-dot {
            width: 8px;
            height: 8px;
            background: var(--danger);
            border-radius: 50%;
            animation: pulse 1.5s infinite;
        }

        @@keyframes pulse {
            0% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.5; transform: scale(1.2); }
            100% { opacity: 1; transform: scale(1); }
        }

        
        .prescriptions-section {
            margin-top: 2rem;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        .section-header h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            color: var(--text-main);
        }

        .prescription-list {
            display: grid;
            gap: 1rem;
        }

        .prescription-card {
            background: #F8FAFC;
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 1.25rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.2s;
        }

        .prescription-card:hover {
            border-color: var(--primary);
            box-shadow: var(--shadow-soft);
        }

        .prescription-info h4 {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 0.25rem;
        }

        .prescription-details {
            display: flex;
            gap: 1rem;
            font-size: 0.875rem;
            color: var(--text-muted);
        }

        .prescription-details span {
            display: flex;
            align-items: center;
            gap: 0.35rem;
        }

        .prescription-actions {
            display: flex;
            gap: 0.5rem;
        }

        .btn-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: white;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-icon:hover {
            color: var(--primary);
            border-color: var(--primary);
            background: #EFF6FF;
        }

        .btn-icon.delete:hover {
            color: var(--danger);
            border-color: var(--danger);
            background: #FEF2F2;
        }

       
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(15, 23, 42, 0.5);
            backdrop-filter: blur(4px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 2000;
        }

        .modal {
            background: white;
            border-radius: var(--radius-lg);
            width: 90%;
            max-width: 500px;
            padding: 2rem;
            box-shadow: var(--shadow-lg);
        }

        .modal-header {
            margin-bottom: 1.5rem;
        }

        .modal-header h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.75rem;
        }

        .form-group {
            margin-bottom: 1rem;
        }

        .form-group label {
            display: block;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            color: var(--text-muted);
            margin-bottom: 0.5rem;
        }

        .form-group input, .form-group textarea {
            width: 100%;
            padding: 0.75rem 1rem;
            border-radius: 12px;
            border: 1px solid var(--border);
            font-family: inherit;
            font-size: 0.95rem;
            transition: all 0.2s;
        }

        .form-group input:focus, .form-group textarea:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
        }

        .modal-footer {
            margin-top: 2rem;
            display: flex;
            justify-content: flex-end;
            gap: 1rem;
        }

        .btn-secondary {
            padding: 0.75rem 1.5rem;
            background: #F1F5F9;
            color: var(--text-main);
            border: none;
            border-radius: var(--radius-pill);
            font-weight: 600;
            cursor: pointer;
        }

        @@media (max-width: 600px) {
            header, main {
                padding: 1rem;
            }

            .profile-header {
                flex-direction: column;
                gap: 1rem;
            }

            #map {
                height: 300px;
            }
        }
    </style>
</head>
<body>

    <header>
        <a href="#" class="logo">
            <i class="ph-fill ph-first-aid-kit"></i> Wellnest
        </a>
        <a asp-controller="CaretakerHome" asp-action="Index" class="back-link">
            <i class="ph-bold ph-arrow-left"></i> Back to Dashboard
        </a>
    </header>

    <main>
        <div class="card profile-container">
            <div class="profile-header">
                <div class="profile-title">
                    <h2>@Model.ElderName</h2>
                    <p class="profile-subtitle">Elder Profile Information</p>
                </div>
            </div>

            <div class="info-grid">
                <div class="info-item">
                    <label>Email Address</label>
                    <span>@Model.Email</span>
                </div>
                <div class="info-item">
                    <label>Age</label>
                    <span>@Model.Age Years</span>
                </div>
                <div class="info-item">
                    <label>Gender</label>
                    <span>@Model.Gender</span>
                </div>
                <div class="info-item">
                    <label>Linked Since</label>
                    <span>@Model.LinkedAt</span>
                </div>
            </div>

            <hr style="border: 0; border-top: 1px solid var(--border); margin: 0 0 1.5rem 0;">

            <div class="controls">
                <button onclick="startWatching()" class="btn-primary">
                    <i class="ph-fill ph-broadcast"></i> Watch Live Location
                </button>

                <button id="btnWatchVideo" onclick="toggleVideo()" class="btn-primary" style="background: var(--secondary); box-shadow: 0 4px 6px -1px rgba(16, 185, 129, 0.2);">
                    <i class="ph-fill ph-video-camera"></i> Watch Live Video
                </button>

                <div id="statusBox">
                    <i class="ph-bold ph-circle"></i> Status: Not started
                </div>
                
                <form asp-controller="CaretakerHome" asp-action="Unassign" method="post" onsubmit="return confirm('Are you sure you want to unassign this elder?');" style="margin-left: auto;">
                    <input type="hidden" name="elderId" value="@Model.ElderId" />
                    <button type="submit" class="btn-primary" style="background: var(--danger); box-shadow: 0 4px 6px -1px rgba(239, 68, 68, 0.2);">
                        <i class="ph-bold ph-trash"></i> Unassign Elder
                    </button>
                </form>
            </div>

            <div id="videoContainer" class="video-container">
                <div class="video-overlay">
                    <div class="live-dot"></div>
                    LIVE FEED
                </div>
                <img id="videoFeed" src="" alt="Live Video Feed">
            </div>

            <div id="map"></div>

            <div class="prescriptions-section">
                <div class="section-header">
                    <h3>Prescriptions</h3>
                    <button class="btn-primary" onclick="openModal()">
                        <i class="ph-bold ph-plus"></i> Add New
                    </button>
                </div>

                <div class="prescription-list" id="prescriptionList">
                    @if (Model.Prescriptions != null && Model.Prescriptions.Any())
                    {
                        @foreach (var p in Model.Prescriptions)
                        {
                            <div class="prescription-card" data-id="@p.PrescriptionID">
                                <div class="prescription-info">
                                    <h4>@p.MedicineName</h4>
                                    <div class="prescription-details">
                                        <span><i class="ph-bold ph-hash"></i> @p.Dosage</span>
                                        <span><i class="ph-bold ph-clock"></i> @p.Frequency</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(p.Notes))
                                    {
                                        <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.5rem;">
                                            Note: @p.Notes
                                        </div>
                                    }
                                </div>
                                <div class="prescription-actions">
                                    <button class="btn-icon" 
                                            data-prescription='@Html.Raw(Json.Serialize(p))' 
                                            onclick="openEditModal(this)">
                                        <i class="ph-bold ph-pencil"></i>
                                    </button>
                                    <button class="btn-icon delete" onclick="deletePrescription(@p.PrescriptionID)">
                                        <i class="ph-bold ph-trash"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div style="text-align: center; padding: 3rem; color: var(--text-muted); background: #F8FAFC; border-radius: 16px; border: 1px dashed var(--border);">
                            <i class="ph-bold ph-pill" style="font-size: 2.5rem; opacity: 0.5; display: block; margin-bottom: 1rem;"></i>
                            No prescriptions added yet.
                        </div>
                    }
                </div>
            </div>
        </div>
    </main>

    <div class="modal-overlay" id="modalOverlay">
        <div class="modal">
            <div class="modal-header">
                <h3 id="modalTitle">Add Prescription</h3>
            </div>
            <form id="prescriptionForm">
                <input type="hidden" id="p_id" name="PrescriptionID" value="0">
                <div class="form-group">
                    <label>Medicine Name</label>
                    <input type="text" id="p_name" name="MedicineName" required placeholder="e.g. Paracetamol">
                </div>
                <div class="form-group">
                    <label>Dosage</label>
                    <input type="text" id="p_dosage" name="Dosage" required placeholder="e.g. 500mg">
                </div>
                <div class="form-group">
                    <label>Frequency</label>
                    <input type="text" id="p_frequency" name="Frequency" required placeholder="e.g. Twice daily">
                </div>
                <div class="form-group">
                    <label>Notes (Optional)</label>
                    <textarea id="p_notes" name="Notes" rows="3" placeholder="Any special instructions..."></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" onclick="closeModal()">Cancel</button>
                    <button type="submit" class="btn-primary">Save Prescription</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        let map = null;
        let marker = null;
        let polyline = null;
        let path = [];
        let intervalId = null;

        const statusBox = document.getElementById("statusBox");

        function setStatusUI(message, type) {
            statusBox.innerHTML = message;

            statusBox.style.background = "#F3F4F6";
            statusBox.style.color = "#64748B";
            statusBox.style.borderColor = "#E2E8F0";

            let iconClass = "ph-circle";

            if (type === 'success') {
                statusBox.style.background = "#DCFCE7";
                statusBox.style.color = "#166534";
                statusBox.style.borderColor = "#86EFAC";
                iconClass = "ph-check-circle";
            } else if (type === 'error') {
                statusBox.style.background = "#FEE2E2";
                statusBox.style.color = "#991B1B";
                statusBox.style.borderColor = "#FCA5A5";
                iconClass = "ph-warning-circle";
            } else if (type === 'warning') {
                statusBox.style.background = "#FEF3C7";
                statusBox.style.color = "#92400E";
                statusBox.style.borderColor = "#FCD34D";
                iconClass = "ph-spinner-gap ph-spin";
            } else if (type === 'info') {
                statusBox.style.background = "#DBEAFE";
                statusBox.style.color = "#1E40AF";
                statusBox.style.borderColor = "#93C5FD";
                iconClass = "ph-info";
            }

            statusBox.innerHTML = `<i class="ph-bold ${iconClass}"></i> Status: ${message}`;
        }

        function startWatching() {
            if (intervalId) return;

            setStatusUI("Connecting to server...", "warning");

            intervalId = setInterval(async () => {
                try {
                    const res = await fetch(`/api/live/@Model.ElderId`);

                    if (res.status === 404) {
                        setStatusUI("No location data yet", "info");
                        return;
                    }

                    if (res.status === 403) {
                        setStatusUI("Not authorized for this elder", "error");
                        return;
                    }

                    if (!res.ok) {
                        setStatusUI("Server error", "error");
                        return;
                    }

                    const data = await res.json();
                    const lat = data.lat;
                    const lng = data.lng;

                    if (!map) {
                        initMap(lat, lng);
                        setStatusUI("Connected", "success");
                    } else {
                        setStatusUI("Receiving live updates...", "success");
                    }

                    marker.setLatLng([lat, lng]);
                    map.panTo([lat, lng]);

                    path.push([lat, lng]);
                    polyline.setLatLngs(path);

                } catch (err) {
                    console.error(err);
                    setStatusUI("Connection failed", "error");
                }
            }, 3000);
        }

        let isVideoPlaying = false;
        const videoContainer = document.getElementById("videoContainer");
        const videoFeed = document.getElementById("videoFeed");
        const btnWatchVideo = document.getElementById("btnWatchVideo");
        const VIDEO_BASE_URL = "http://localhost:5259";

        function toggleVideo() {
            if (isVideoPlaying) {
                stopVideo();
            } else {
                startVideo();
            }
        }

        function startVideo() {
            isVideoPlaying = true;
            videoContainer.style.display = "block";
            const streamUrl = `${VIDEO_BASE_URL}/stream/@Model.ElderId`;
            console.log("Starting video stream for Elder:", "@Model.ElderId");
            console.log("Stream URL:", streamUrl);
            videoFeed.src = streamUrl;
            btnWatchVideo.innerHTML = '<i class="ph-fill ph-stop-circle"></i> Stop Live Video';
            btnWatchVideo.style.background = 'var(--danger)';
            btnWatchVideo.style.boxShadow = '0 4px 6px -1px rgba(239, 68, 68, 0.2)';
            
            setStatusUI("Video feed active", "success");
        }

        function stopVideo() {
            isVideoPlaying = false;
            videoContainer.style.display = "none";
            videoFeed.src = ""; 
            btnWatchVideo.innerHTML = '<i class="ph-fill ph-video-camera"></i> Watch Live Video';
            btnWatchVideo.style.background = 'var(--secondary)';
            btnWatchVideo.style.boxShadow = '0 4px 6px -1px rgba(16, 185, 129, 0.2)';
            
            setStatusUI("Video feed stopped", "info");
        }

        function initMap(lat, lng) {
            map = L.map("map").setView([lat, lng], 17);

            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                maxZoom: 19,
                attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
            }).addTo(map);

            marker = L.marker([lat, lng]).addTo(map);
            polyline = L.polyline([], { color: "#2563EB", weight: 4 }).addTo(map);
        }

        const overlay = document.getElementById("modalOverlay");
        const form = document.getElementById("prescriptionForm");

        function openModal() {
            document.getElementById("modalTitle").innerText = "Add Prescription";
            form.reset();
            document.getElementById("p_id").value = "0";
            overlay.style.display = "flex";
        }

        function closeModal() {
            overlay.style.display = "none";
        }

        function openEditModal(btn) {
            const p = JSON.parse(btn.getAttribute('data-prescription'));
            document.getElementById("modalTitle").innerText = "Edit Prescription";
            document.getElementById("p_id").value = p.prescriptionID;
            document.getElementById("p_name").value = p.medicineName;
            document.getElementById("p_dosage").value = p.dosage;
            document.getElementById("p_frequency").value = p.frequency;
            document.getElementById("p_notes").value = p.notes || "";
            overlay.style.display = "flex";
        }

        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            const formData = new FormData(form);
            const data = Object.fromEntries(formData.entries());
            data.ElderID = @Model.ElderId;
            data.CaretakerID = 0;

            const isEdit = data.PrescriptionID != "0";
            const url = isEdit ? `/api/elder/prescription/${data.PrescriptionID}` : "/api/elder/prescription";
            const method = isEdit ? "PUT" : "POST";

            try {
                const res = await fetch(url, {
                    method: method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (res.ok) {
                    location.reload();
                } else {
                    alert("Failed to save prescription");
                }
            } catch (err) {
                console.error(err);
                alert("An error occurred");
            }
        });

        async function deletePrescription(id) {
            if (!confirm("Are you sure you want to delete this prescription?")) return;

            try {
                const res = await fetch(`/api/elder/prescription/${id}`, { method: 'DELETE' });
                if (res.ok) {
                    location.reload();
                } else {
                    alert("Failed to delete");
                }
            } catch (err) {
                console.error(err);
                alert("An error occurred");
            }
        }
    </script>
</body>
</html>
