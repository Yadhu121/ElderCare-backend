@model wellcare.Models.ElderProfileViewModel

@{
    Layout = null;
    ViewData["Title"] = "Elder Profile";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/@@phosphor-icons/web"></script>

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <style>
        :root {
            --primary: #2563EB;
            --primary-dark: #1E40AF;
            --secondary: #10B981;
            --danger: #EF4444;
            --warning: #F59E0B;
            --bg-color: #F8FAFC;
            --card-bg: #FFFFFF;
            --text-main: #0F172A;
            --text-muted: #64748B;
            --border: #E2E8F0;
            --radius-lg: 24px;
            --radius-pill: 50px;
            --shadow-soft: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.025);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            line-height: 1.6;
        }

        header {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border);
            padding: 1rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 1.5rem;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
        }

        .back-link {
            text-decoration: none;
            color: var(--text-muted);
            font-weight: 600;
            font-size: 0.875rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: color 0.2s;
        }

            .back-link:hover {
                color: var(--primary);
            }

        main {
            flex: 1;
            padding: 2rem;
            width: 100%;
            max-width: 1000px;
            margin: 0 auto;
        }

        .profile-container {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .card {
            background: var(--card-bg);
            border-radius: var(--radius-lg);
            padding: 2rem;
            box-shadow: var(--shadow-lg);
            border: 1px solid var(--border);
        }

        .profile-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 2rem;
        }

        .profile-title h2 {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            color: var(--text-main);
            margin-bottom: 0.25rem;
        }

        .profile-subtitle {
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .info-item label {
            display: block;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            margin-bottom: 0.25rem;
            font-weight: 600;
        }

        .info-item span {
            font-size: 1.125rem;
            font-weight: 600;
            color: var(--text-main);
        }

        .controls {
            display: flex;
            gap: 1rem;
            align-items: center;
            flex-wrap: wrap;
            margin-bottom: 1.5rem;
        }

        .btn-primary {
            padding: 0.75rem 1.5rem;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: var(--radius-pill);
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.2);
        }

            .btn-primary:hover {
                background: var(--primary-dark);
                transform: translateY(-2px);
                box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.3);
            }

        #statusBox {
            padding: 0.75rem 1.25rem;
            border-radius: var(--radius-pill);
            font-size: 0.875rem;
            font-weight: 500;
            background: #F3F4F6;
            color: var(--text-muted);
            border: 1px solid var(--border);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
        }

        #map {
            height: 400px;
            width: 100%;
            border-radius: 16px;
            z-index: 1;
            margin-top: 1rem;
        }

        @@media (max-width: 600px) {
            header, main {
                padding: 1rem;
            }

            .profile-header {
                flex-direction: column;
                gap: 1rem;
            }

            #map {
                height: 300px;
            }
        }
    </style>
</head>
<body>

    <header>
        <a href="#" class="logo">
            <i class="ph-fill ph-first-aid-kit"></i> Wellnest
        </a>
        <a asp-controller="CaretakerHome" asp-action="Index" class="back-link">
            <i class="ph-bold ph-arrow-left"></i> Back to Dashboard
        </a>
    </header>

    <main>
        <div class="card profile-container">
            <div class="profile-header">
                <div class="profile-title">
                    <h2>@Model.ElderName</h2>
                    <p class="profile-subtitle">Elder Profile Information</p>
                </div>
            </div>

            <div class="info-grid">
                <div class="info-item">
                    <label>Email Address</label>
                    <span>@Model.Email</span>
                </div>
                <div class="info-item">
                    <label>Age</label>
                    <span>@Model.Age Years</span>
                </div>
                <div class="info-item">
                    <label>Gender</label>
                    <span>@Model.Gender</span>
                </div>
                <div class="info-item">
                    <label>Linked Since</label>
                    <span>@Model.LinkedAt</span>
                </div>
            </div>

            <hr style="border: 0; border-top: 1px solid var(--border); margin: 0 0 1.5rem 0;">

            <div class="controls">
                <button onclick="startWatching()" class="btn-primary">
                    <i class="ph-fill ph-broadcast"></i> Watch Live Location
                </button>

                <div id="statusBox">
                    <i class="ph-bold ph-circle"></i> Status: Not started
                </div>
            </div>

            <div id="map"></div>
        </div>
    </main>

    <script>
        let map = null;
        let marker = null;
        let polyline = null;
        let path = [];
        let intervalId = null;

        const statusBox = document.getElementById("statusBox");

        function setStatusUI(message, type) {
            statusBox.innerHTML = message;

            statusBox.style.background = "#F3F4F6";
            statusBox.style.color = "#64748B";
            statusBox.style.borderColor = "#E2E8F0";

            let iconClass = "ph-circle";

            if (type === 'success') {
                statusBox.style.background = "#DCFCE7";
                statusBox.style.color = "#166534";
                statusBox.style.borderColor = "#86EFAC";
                iconClass = "ph-check-circle";
            } else if (type === 'error') {
                statusBox.style.background = "#FEE2E2";
                statusBox.style.color = "#991B1B";
                statusBox.style.borderColor = "#FCA5A5";
                iconClass = "ph-warning-circle";
            } else if (type === 'warning') {
                statusBox.style.background = "#FEF3C7";
                statusBox.style.color = "#92400E";
                statusBox.style.borderColor = "#FCD34D";
                iconClass = "ph-spinner-gap ph-spin";
            } else if (type === 'info') {
                statusBox.style.background = "#DBEAFE";
                statusBox.style.color = "#1E40AF";
                statusBox.style.borderColor = "#93C5FD";
                iconClass = "ph-info";
            }

            statusBox.innerHTML = `<i class="ph-bold ${iconClass}"></i> Status: ${message}`;
        }

        function startWatching() {
            if (intervalId) return;

            setStatusUI("Connecting to server...", "warning");

            intervalId = setInterval(async () => {
                try {
                    const res = await fetch(`/api/live/@Model.ElderId`);

                    if (res.status === 404) {
                        setStatusUI("No location data yet", "info");
                        return;
                    }

                    if (res.status === 403) {
                        setStatusUI("Not authorized for this elder", "error");
                        return;
                    }

                    if (!res.ok) {
                        setStatusUI("Server error", "error");
                        return;
                    }

                    const data = await res.json();
                    const lat = data.lat;
                    const lng = data.lng;

                    if (!map) {
                        initMap(lat, lng);
                        setStatusUI("Connected", "success");
                    } else {
                        setStatusUI("Receiving live updates...", "success");
                    }

                    marker.setLatLng([lat, lng]);
                    map.panTo([lat, lng]);

                    path.push([lat, lng]);
                    polyline.setLatLngs(path);

                } catch (err) {
                    console.error(err);
                    setStatusUI("Connection failed", "error");
                }
            }, 3000);
        }

        function initMap(lat, lng) {
            map = L.map("map").setView([lat, lng], 17);

            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                maxZoom: 19,
                attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
            }).addTo(map);

            marker = L.marker([lat, lng]).addTo(map);
            polyline = L.polyline([], { color: "#2563EB", weight: 4 }).addTo(map);
        }
    </script>
</body>
</html>
